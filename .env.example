# ─── Dominio público (Traefik) ─────────────────────────────────────────
# Subdominio donde se publicará la app. Traefik emite el certificado HTTPS
# para este host. Debe tener un registro DNS A apuntando a la IP del VPS.
#   APP_DOMAIN=obsiagent.tudominio.com
APP_DOMAIN=

# ─── Base de datos (Postgres + pgvector) ───────────────────────────────
# En despliegue con docker-compose el host es "db" (nombre del servicio) y
# docker-compose.yml ya lo sobreescribe. Este "localhost" es solo para
# ejecutar la app FUERA de Docker (desarrollo local).
DATABASE_URL=postgres://obsi:obsi@localhost:5432/obsiagent

# ─── Vault de Obsidian ─────────────────────────────────────────────────
# En Docker se usa /data/vault (lo fija docker-compose.yml). Para desarrollo
# local en Windows: OBSIDIAN_VAULT_PATH=C:/Users/josec/Documents/MiVault
OBSIDIAN_VAULT_PATH=./vault-dev

# ─── Claude (Anthropic) — resúmenes, auto-enlaces y respuestas RAG ─────
ANTHROPIC_API_KEY=sk-ant-...
# Modelo para digerir documentos (crear notas): calidad alta.
ANTHROPIC_MODEL=claude-sonnet-4-6
# Modelo para las respuestas de /search (RAG): rápido y barato.
ANTHROPIC_ANSWER_MODEL=claude-haiku-4-5-20251001

# ─── Voyage AI — embeddings para búsqueda semántica ───────────────────
# Claude NO genera embeddings; Anthropic recomienda Voyage AI.
# ⚠️ NO pongas la key real aquí: este archivo se sube a git. Va en .env
VOYAGE_API_KEY=pa-...
VOYAGE_MODEL=voyage-3.5
VOYAGE_DIM=1024

# ─── Importación masiva (/api/bulk-import y /api/reindex) ──────────────
# Token requerido para disparar la importación/reindex. Inventa uno largo y
# secreto (ej. una cadena aleatoria). Sin esto, esos endpoints se bloquean.
BULK_IMPORT_TOKEN=
# Carpeta DENTRO del contenedor donde dejas los archivos a importar.
# El docker-compose la mapea a /srv/obsiagent/inbox del host.
INBOX_PATH=/data/inbox

# ─── Evolution API (WhatsApp) ──────────────────────────────────────────
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=obsiagent
# Números permitidos para consultar el vault por WhatsApp (coma-separado).
# Formato internacional sin "+". Vacío = se permiten todos (NO recomendado).
WHATSAPP_ALLOWED_NUMBERS=
